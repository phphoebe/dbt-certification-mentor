# OpenAI API key (required)
OPENAI_API_KEY=sk-your-key-here

# Vector store ID (required) — create via OpenAI API and upload the dbt study guide PDF
# See README.md for setup instructions
vector_store_id=vs_your-vector-store-id-here

# Optional: override chat model (default gpt-4.1). Also synced to OPENAI_DEFAULT_MODEL at startup.
# OPENAI_AGENT_MODEL=gpt-4o
#
# Do not set OPENAI_DEFAULT_MODEL to random / internal ids (breaks the Agents SDK with 404).
